<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================== PERMISSIONS ==================== -->

    <!-- Networking (Retrofit) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- QR scanning -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Google Maps + nearby stations -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Camera feature (not required so tablets can still install) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- ==================== APPLICATION ==================== -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartMicrogrid"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Google Maps API Key (replace with your real key later) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_MAPS_API_KEY_HERE" />

        <!-- ==================== AUTH ==================== -->

        <!-- Main entry point: routes straight to the role home if a valid session exists -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ==================== HOME (PLACEHOLDERS) ==================== -->

        <activity
            android:name=".ui.prosumer.ProsumerHomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.operator.OperatorHomeActivity"
            android:exported="false" />

        <!-- ==================== BOOKING (CREATE FLOW) ==================== -->

        <activity
            android:name=".ui.booking.StationPickerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.booking.SlotPickerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.booking.ConfirmBookingActivity"
            android:exported="false" />

        <!-- Reusable: also the result screen for update/cancel in the next round -->
        <activity
            android:name=".ui.booking.BookingSummaryActivity"
            android:exported="false" />

        <!-- MainActivity is intentionally NOT registered (Android Studio template leftover). -->

    </application>

</manifest>