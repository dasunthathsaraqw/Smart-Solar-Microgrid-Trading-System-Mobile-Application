<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and older (Android 12+ uses data_extraction_rules.xml).
   See https://developer.android.com/guide/topics/data/autobackup for details.
-->
<full-backup-content>
    <!-- The offline cache (Room database) holds personal data — bookings, the profile with NIC and
         address — and is rebuilt by the next successful fetch, so it is never backed up. Room also
         keeps -wal and -shm side files. Keep the name in step with AppDatabase.DATABASE_NAME. -->
    <exclude domain="database" path="solar_microgrid_cache.db" />
    <exclude domain="database" path="solar_microgrid_cache.db-wal" />
    <exclude domain="database" path="solar_microgrid_cache.db-shm" />
</full-backup-content>
