<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shapes -->
    <style name="ShapeAppearance.App.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_sm</item>
    </style>
    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_md</item>
    </style>
    <style name="ShapeAppearance.App.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_lg</item>
    </style>

    <!-- Buttons: filled (primary action) is the default; tonal / text for lesser actions -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner_md</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.App.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner_md</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner_md</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner_md</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Text fields: filled everywhere -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_md</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceVariant</item>
    </style>

    <!-- Cards: outlined for list items, hero for the one card per screen that should stand out -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/corner_md</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>
    <!-- Stat tile: tinted fill set per card, no outline -->
    <style name="Widget.App.Card.Stat" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/corner_md</item>
        <item name="cardElevation">@dimen/elevation_none</item>
    </style>
    <!-- Floating status card over a map or camera preview -->
    <style name="Widget.App.Card.Floating" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_lg</item>
        <item name="cardElevation">@dimen/elevation_raised</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>
    <style name="Widget.App.Card.Hero" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/corner_lg</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
    </style>

    <!-- Status chip. Kotlin sets the text colour and stroke colour per status, so the stroke
         must stay visible; the neutral surface fill keeps it readable on any card. -->
    <style name="Widget.App.Chip.Status" parent="Widget.Material3.Chip.Assist">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Small</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipBackgroundColor">?attr/colorSurface</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.App.ToolbarTitle</item>
        <item name="subtitleTextAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="subtitleTextColor">@color/gray</item>
    </style>
    <style name="TextAppearance.App.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Text roles -->
    <style name="TextAppearance.App.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.App.SectionHeader" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.App.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/gray</item>
    </style>
    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/gray</item>
    </style>
</resources>
