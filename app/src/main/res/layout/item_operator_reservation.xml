<?xml version="1.0" encoding="utf-8"?>
<!--
    File: item_operator_reservation.xml
    Purpose: One reservation row for the operator screens (dashboard upcoming preview, pending
             approvals, completed history) — prosumer name, NIC, slot time and a status chip.
             Unlike item_booking.xml it leads with WHO booked, because the station is always the
             operator's own. tvCompletedAt is hidden unless the Activity fills it (history).
             The whole card is tappable (opens a read-only detail sheet).
    Author: Mobile Team
    Date: 2026
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_person"
            app:tint="?attr/colorOnPrimaryContainer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProsumerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.SectionHeader"
                android:textStyle="bold"
                tools:text="Kamal Perera" />

            <TextView
                android:id="@+id/tvProsumerNic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Secondary"
                tools:text="NIC: 200012345678" />

            <TextView
                android:id="@+id/tvSlotTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="25 Sep 2026, 14:00 – 15:00" />

            <TextView
                android:id="@+id/tvCompletedAt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Secondary"
                android:visibility="gone"
                tools:text="Completed: 25 Sep 2026, 15:05"
                tools:visibility="visible" />

            <!-- Status chip: Kotlin sets its text and status colour -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatus"
                style="@style/Widget.App.Chip.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:clickable="false"
                android:focusable="false"
                app:ensureMinTouchTargetSize="false"
                tools:text="Pending" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
