<?xml version="1.0" encoding="utf-8"?>
<!--
    File: activity_booking_detail.xml
    Purpose: One reservation in full — station, slot time, capacity, status, and the timestamps
             that apply (each timestamp row is hidden by the Activity when the value is null) —
             with Update Slot / Cancel Booking / Show QR actions pinned at the bottom. Every
             action button is hidden by default; the Activity shows the ones that apply to the
             reservation's status. Also holds the loading spinner and the error/retry state; the
             Activity toggles contentScroll / progressBar / errorContainer.
    Author: Mobile Team
    Date: 2026
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.booking.BookingDetailActivity">

    <!-- ==================== TOOLBAR ==================== -->
    <com.google.android.material.appbar.MaterialToolbar
        style="@style/Widget.App.Toolbar"
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/action_navigate_up"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/title_booking_detail" />
    <!-- ==================== OFFLINE CACHE BANNER ==================== -->
    <!-- Hidden unless the screen is showing cached data; content below is anchored to it, so it
         takes no space when hidden. -->
    <include
        android:id="@+id/cachedBanner"
        layout="@layout/view_cached_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- ==================== CONTENT ==================== -->
    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/actionsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cachedBanner"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingVertical="@dimen/spacing_lg">

            <!-- ==================== RESERVATION ==================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_xl">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_station_name"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <TextView
                        android:id="@+id/tvStationName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.SectionHeader"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textStyle="bold"
                        tools:text="Colombo North Hub" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/label_slot_time"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <TextView
                        android:id="@+id/tvSlotTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.SectionHeader"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textStyle="bold"
                        tools:text="25 Sep 2026, 14:00 – 15:00" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/label_capacity"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <TextView
                        android:id="@+id/tvCapacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.SectionHeader"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textStyle="bold"
                        tools:text="5.5 kW" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/label_status"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStatus"
                        style="@style/Widget.App.Chip.Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:clickable="false"
                        android:focusable="false"
                        app:ensureMinTouchTargetSize="false"
                        tools:text="Approved" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== TIMELINE ==================== -->
            <!-- Created is always present; the others are hidden by the Activity when null. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:id="@+id/rowCreated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_created_at"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            android:textColor="@color/gray" />

                        <TextView
                            android:id="@+id/tvCreatedAt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="20 Sep 2026, 10:00" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowApproved"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_approved_at"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            android:textColor="@color/gray" />

                        <TextView
                            android:id="@+id/tvApprovedAt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="24 Sep 2026, 10:00" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowCompleted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_completed_at"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            android:textColor="@color/gray" />

                        <TextView
                            android:id="@+id/tvCompletedAt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="25 Sep 2026, 15:05" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowCancelled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_cancelled_at"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            android:textColor="@color/gray" />

                        <TextView
                            android:id="@+id/tvCancelledAt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="22 Sep 2026, 09:30" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowCancellationReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_cancellation_reason"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            android:textColor="@color/gray" />

                        <TextView
                            android:id="@+id/tvCancellationReason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="Change of plans" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- ==================== LOADING ==================== -->
    <!-- Visible by default (screen starts loading); the Activity also shows it over the content
         while an update/cancel request is in flight. -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/actionsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cachedBanner" />

    <!-- ==================== ERROR ==================== -->
    <LinearLayout
        android:id="@+id/errorContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_xl"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cachedBanner"
        tools:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/error_loading_detail"
            android:textAppearance="@style/TextAppearance.App.SectionHeader"
            android:textStyle="bold" />

        <!-- Backend / network message, set by the Activity -->
        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/error"
            tools:text="Network error. Please check your connection." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="@style/Widget.App.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/action_retry" />
    </LinearLayout>

    <!-- ==================== ACTIONS ==================== -->
    <!-- Pinned so they stay reachable when the content scrolls. Spacing lives on the buttons
         (bottom margins), not the container, so the bar takes no space when every button is
         hidden. -->
    <LinearLayout
        android:id="@+id/actionsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowQr"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="@string/action_show_qr"
            android:visibility="gone"
            app:icon="@drawable/ic_qr_code"
            app:iconSize="@dimen/icon_size"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateSlot"
            style="@style/Widget.App.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="@string/action_update_slot"
            android:visibility="gone"
            app:icon="@drawable/ic_edit"
            app:iconSize="@dimen/icon_size" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelBooking"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginBottom="@dimen/spacing_md"
            android:text="@string/action_cancel_booking"
            android:textColor="@color/error"
            android:visibility="gone"
            app:icon="@drawable/ic_cancel"
            app:iconSize="@dimen/icon_size"
            app:iconTint="@color/error"
            app:strokeColor="@color/error" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
