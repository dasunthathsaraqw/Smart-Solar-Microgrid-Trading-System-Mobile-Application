<?xml version="1.0" encoding="utf-8"?>
<!--
    File: activity_nearby_stations.xml
    Purpose: Nearby Stations — a Google map (SupportMapFragment) under a toolbar, with overlays
             for each non-map state. The Activity shows at most one of these at a time:
             cardLoading (a floating card over the map, message set per step: "Getting your
             location…" / "Finding stations…"), permissionContainer (location access refused),
             errorContainer (location unavailable / stations request failed), cardEmpty (a
             floating note over the map when nothing is within range). The permission and
             error overlays are opaque and cover the map.
    Author: Mobile Team
    Date: 2026
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.maps.NearbyStationsActivity">

    <!-- ==================== TOOLBAR ==================== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/action_navigate_up"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/title_nearby_stations" />

    <!-- ==================== MAP ==================== -->
    <!-- SupportMapFragment manages the map's lifecycle itself; the Activity calls getMapAsync
         on it. Needs a real Maps API key in the manifest to draw tiles. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- ==================== LOADING ==================== -->
    <!-- Visible by default: the screen starts by getting the location. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLoading"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/tvLoadingMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/msg_getting_location"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ==================== EMPTY ==================== -->
    <!-- Floats near the bottom so the map (centred on the user) stays visible. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEmpty"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="gone">

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/label_no_nearby_stations"
            android:textAppearance="?attr/textAppearanceBodyLarge" />
    </com.google.android.material.card.MaterialCardView>

    <!-- ==================== PERMISSION DENIED ==================== -->
    <!-- Opaque so the map underneath can't be interacted with. The Activity shows Grant
         Permission while the system will still show its prompt, and Open Settings once the
         user has refused permanently. -->
    <LinearLayout
        android:id="@+id/permissionContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="gone">

        <!-- The ViewModel's message (msg_location_permission_denied) is set by the Activity -->
        <TextView
            android:id="@+id/tvPermissionMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="Location permission is needed to find solar stations near you." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="@string/action_grant_permission" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenSettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/action_open_settings"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ==================== ERROR ==================== -->
    <!-- Location unavailable, or the stations request failed. Opaque, like the permission state. -->
    <LinearLayout
        android:id="@+id/errorContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/error_loading_nearby_stations"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold" />

        <!-- Location or backend / network message, set by the Activity -->
        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/error"
            tools:text="Network error. Please check your connection." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/action_retry" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
