<?xml version="1.0" encoding="utf-8"?>
<!--
    File: activity_qr_display.xml
    Purpose: Shows the QR code for an Approved reservation — station and slot time, the code
             itself on a white tile (so it stays scannable in dark mode), and a validity note.
             Holds the loading spinner and the error/retry state; the Activity toggles which of
             contentScroll / progressBar / errorContainer is visible.
    Author: Mobile Team
    Date: 2026
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.booking.QrDisplayActivity">

    <!-- ==================== TOOLBAR ==================== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.App.Toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/action_navigate_up"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/title_qr_code" />

    <!-- ==================== CONTENT ==================== -->
    <!-- Scrolls only if needed (small screens / landscape); otherwise centred. Hidden until the
         QR is ready. -->
    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingVertical="@dimen/spacing_lg">

            <TextView
                android:id="@+id/tvStationName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:text="Colombo North Hub" />

            <TextView
                android:id="@+id/tvSlotTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.App.Secondary"
                tools:text="25 Sep 2026, 14:00 – 15:00" />

            <!-- Framed ticket: a white card with a primary outline holds the code. The white
                 ImageView background + padding is the QR's quiet zone, whatever the theme. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_lg"
                app:cardElevation="@dimen/elevation_card"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/ivQr"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:layout_margin="@dimen/spacing_sm"
                    android:background="@color/white"
                    android:contentDescription="@string/content_desc_qr_code"
                    android:padding="@dimen/spacing_md"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvValidNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:gravity="center"
                android:text="@string/label_qr_valid_note"
                android:textAppearance="@style/TextAppearance.App.Secondary" />
        </LinearLayout>
    </ScrollView>

    <!-- ==================== LOADING ==================== -->
    <!-- Visible by default: the screen starts in the loading state. -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- ==================== ERROR ==================== -->
    <LinearLayout
        android:id="@+id/errorContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_xl"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/error_loading_qr"
            android:textAppearance="@style/TextAppearance.App.SectionHeader"
            android:textStyle="bold" />

        <!-- Backend / network message, set by the Activity (e.g. "only for Approved reservations") -->
        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/error"
            tools:text="Network error. Please check your connection." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="@style/Widget.App.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/action_retry" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
